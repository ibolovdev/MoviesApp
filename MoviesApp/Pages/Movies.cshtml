@page
@model MoviesApp.Pages.MoviesModel
@{
}

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">#</th>
            <th scope="col">Title</th>
            <th scope="col">Rate</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>

        @foreach (var _movie in Model.movies)
        {
            <tr>
                <th scope="row">@_movie.Id</th>
                <td>@_movie.Title</td>
                <td>@_movie.Rate/10</td>
                <td><a href="/Movie/@_movie.Id" class="btn btn-secondary">Show details</a></td>
            </tr>
        }
    </tbody>
</table>



<a href="/AddMovie/" class="btn btn-secondary">Add movie</a>

